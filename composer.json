{
    "name": "php-anonymizer/anonymizer-dev",
    "description": "Development workspace for the PHP Anonymizer packages",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.5",
        "ext-mbstring": "*",
        "thecodingmachine/safe": "^3.4"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7.1",
        "ergebnis/composer-normalize": "^2.52",
        "fakerphp/faker": "^1.24",
        "friendsofphp/php-cs-fixer": "^3.95.19",
        "infection/infection": "^0.35",
        "laravel/framework": "^13.0",
        "nikic/php-parser": "^5.8",
        "orchestra/testbench": "^11.0",
        "orchestra/testbench-core": "^11.0",
        "php-anonymizer/anonymizer": "@dev",
        "php-anonymizer/anonymizer-bundle": "@dev",
        "php-anonymizer/anonymizer-faker": "@dev",
        "php-anonymizer/anonymizer-laravel": "@dev",
        "php-anonymizer/anonymizer-personas": "@dev",
        "php-anonymizer/anonymizer-pseudonymization": "@dev",
        "php-anonymizer/anonymizer-symfony-serializer": "@dev",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.2.8",
        "phpstan/phpstan-deprecation-rules": "^2.0.5",
        "phpstan/phpstan-phpunit": "^2.0.18",
        "phpstan/phpstan-strict-rules": "^2.0.12",
        "phpunit/phpunit": "^13.3.1",
        "psr/log": "^3.0",
        "rector/rector": "^2.6.2",
        "shipmonk/composer-dependency-analyser": "^1.8.4",
        "shipmonk/name-collision-detector": "^2.1.1",
        "spaze/phpstan-disallowed-calls": "^4.14",
        "symfony/config": "^8.1.4",
        "symfony/dependency-injection": "^8.1.4",
        "symfony/framework-bundle": "^8.1.4",
        "symfony/http-kernel": "^8.1.4",
        "symfony/property-access": "^8.1.4",
        "symfony/serializer": "^8.1.4",
        "symfony/yaml": "^8.1.2",
        "thecodingmachine/phpstan-safe-rule": "^1.4.7",
        "tomasvotruba/cognitive-complexity": "^1.2"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "PhpAnonymizer\\Anonymizer\\": "packages/anonymizer/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpAnonymizer\\AnonymizerBundle\\Tests\\": "packages/anonymizer-bundle/tests/",
            "PhpAnonymizer\\AnonymizerFaker\\Tests\\": "packages/anonymizer-faker/tests/",
            "PhpAnonymizer\\AnonymizerLaravel\\Tests\\": "packages/anonymizer-laravel/tests/",
            "PhpAnonymizer\\AnonymizerPersonas\\Tests\\": "packages/anonymizer-personas/tests/",
            "PhpAnonymizer\\AnonymizerPseudonymization\\Tests\\": "packages/anonymizer-pseudonymization/tests/",
            "PhpAnonymizer\\AnonymizerSymfonySerializer\\Tests\\": "packages/anonymizer-symfony-serializer/tests/",
            "PhpAnonymizer\\Anonymizer\\Tests\\": "packages/anonymizer/tests/",
            "PhpAnonymizer\\Workspace\\PHPStan\\": "tools/PHPStan/",
            "PhpAnonymizer\\Workspace\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "architecture": "@php vendor/bin/deptrac analyse --config-file=deptrac.yaml",
        "artifacts": "@php tools/build-artifacts.php",
        "audit:security": "composer audit --locked",
        "check": [
            "@validate:metadata",
            "@audit:security",
            "@lint",
            "@static",
            "@dependencies",
            "@documentation",
            "@public-api",
            "@structure",
            "@collisions",
            "@architecture",
            "@refactor:check",
            "@test"
        ],
        "collisions": "@php vendor/bin/detect-collisions packages tests tools/PHPStan",
        "consumer": "@php tools/consumer-test.php",
        "consumer:bundle": "@php tools/bundle-consumer-test.php",
        "consumer:faker": "@php tools/faker-consumer-test.php",
        "consumer:laravel": "@php tools/laravel-consumer-test.php",
        "consumer:personas": "@php tools/personas-consumer-test.php",
        "consumer:profile-provider": "@php tools/profile-provider-consumer-test.php",
        "consumer:pseudonymization": "@php tools/pseudonymization-consumer-test.php",
        "consumer:serializer": "@php tools/serializer-consumer-test.php",
        "dependencies": "@php vendor/bin/composer-dependency-analyser",
        "documentation": "@php tools/check-doc-examples.php",
        "fix": "@php vendor/bin/php-cs-fixer fix",
        "lint": "@php vendor/bin/php-cs-fixer fix --dry-run --diff",
        "mutation": "@php tools/run-infection.php",
        "public-api": "@php tools/check-public-api.php",
        "qa": [
            "@check",
            "@test:coverage",
            "@mutation",
            "@consumer",
            "@consumer:bundle",
            "@consumer:faker",
            "@consumer:personas",
            "@consumer:profile-provider",
            "@consumer:pseudonymization",
            "@consumer:serializer",
            "@consumer:laravel",
            "@release:preview:test",
            "@artifacts"
        ],
        "rector:fix": "@php vendor/bin/rector process",
        "refactor:check": [
            "@php vendor/bin/rector process --dry-run",
            "@php vendor/bin/rector process --config=rector-safe.php --dry-run"
        ],
        "release:preview": "@php tools/release-preview.php",
        "release:preview:test": "@php tools/release-preview-test.php",
        "release:publish": "@php tools/release-publish.php",
        "release:verify": "@php tools/release-verify.php",
        "static": "@php vendor/bin/phpstan analyse --configuration=phpstan.neon",
        "structure": "@php tools/check-structure.php",
        "test": "@php vendor/bin/phpunit --configuration=phpunit.xml",
        "test:coverage": [
            "@php tools/run-coverage.php",
            "@php tools/check-coverage.php"
        ],
        "validate:metadata": [
            "composer normalize --dry-run",
            "composer validate --strict",
            "@php tools/validate-packages.php"
        ]
    }
}
