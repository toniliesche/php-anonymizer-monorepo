{
    "name": "php-anonymizer/anonymizer-pseudonymization",
    "description": "Keyed deterministic pseudonymisation for PHP Anonymizer",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.5",
        "php-anonymizer/anonymizer": "^2.0",
        "webmozart/assert": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "PhpAnonymizer\\AnonymizerPseudonymization\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpAnonymizer\\AnonymizerPseudonymization\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-develop": "2.0.x-dev"
        }
    }
}
