{
    "name": "php-anonymizer/anonymizer-bundle",
    "description": "Symfony integration for PHP Anonymizer",
    "license": "MIT",
    "type": "symfony-bundle",
    "require": {
        "php": "^8.5",
        "php-anonymizer/anonymizer": "^1.0",
        "symfony/config": "^8.1.4",
        "symfony/dependency-injection": "^8.1.4",
        "symfony/http-kernel": "^8.1.4",
        "thecodingmachine/safe": "^3.4"
    },
    "autoload": {
        "psr-4": {
            "PhpAnonymizer\\AnonymizerBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpAnonymizer\\AnonymizerBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "symfony": {
            "extension-class": "PhpAnonymizer\\AnonymizerBundle\\DependencyInjection\\AnonymizerExtension"
        }
    }
}
